---
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<Base titolo="Messaggio inviato · Pagella Energia" descrizione="Grazie per averci scritto." pagina="contatti">
  <div class="wrap">
    <section style="padding-block:64px 32px;max-width:620px;display:flex;flex-direction:column;gap:16px">
      <h1 style="font-size:40px;line-height:1.1;margin:0">Grazie, messaggio inviato!</h1>
      <p style="font-size:18px;line-height:1.55;color:var(--ink-muted);margin:0">L'ho ricevuto e lo leggerò con calma. Se hai lasciato la tua email, ti risponderò lì.</p>
      <p style="margin:8px 0 0;display:flex;gap:12px;flex-wrap:wrap">
        <a class="pe-btn" href={`${base}`}>Torna alla home</a>
        <a class="pe-btn-secondary" href={`${base}risultati/`}>Confronta le offerte</a>
      </p>
    </section>
  </div>
</Base>
